<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D-068: local OTP fake uses cleartext HTTP. D-150: the main manifest
         now carries a loopback-only cleartext config for standalone builds. -->
    <application android:usesCleartextTraffic="true">
        <receiver
            android:name=".DeliveredSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- PE-003: debug builds also receive an emulator SMS. Release does not. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
</manifest>
