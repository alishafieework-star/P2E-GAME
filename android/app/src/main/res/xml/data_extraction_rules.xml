<?xml version="1.0" encoding="utf-8"?>
<!-- D-154: session cookies must not leave the device in a cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
